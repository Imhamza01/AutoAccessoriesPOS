    .quick-actions {
        flex-wrap: wrap;
    }

    .quick-action-btn {
        flex: 1;
        justify-content: center;
    }

    .table-header {
        flex-direction: column;
        align-items: stretch;
    }

    .table-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .pagination-controls {
        justify-content: center;
    }

    .bulk-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .bulk-buttons {
        justify-content: stretch;
    }

    .bulk-buttons button {
        flex: 1;
    }
}

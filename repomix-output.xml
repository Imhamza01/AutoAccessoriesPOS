/* Responsive Design */
@media (max-width: 768px) {
    .sidebar-wrapper {
        width: 250px;
        position: fixed;
        top: 70px;
        left: 0;
        height: calc(100vh - 70px);
        z-index: 999;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
    }

    .sidebar-wrapper.mobile-open {
        transform: translateX(0);
    }

    .sidebar-close-btn {
        display: block !important;
    }

    .menu-label {
        padding-left: 1rem;
    }

    .menu-items {
        padding: 0 0.5rem;
    }
}

@media (max-width: 480px) {
    .sidebar-wrapper {
        width: 200px;
    }

    .btn-text {
        font-size: 0.875rem;
    }

    .sidebar-footer {
        font-size: 0.75rem;
    }
}

/* Dark Mode Support */
@media (prefers-color-scheme: dark) {
    .sidebar-wrapper {
        background: linear-gradient(180deg, #1e2d3d 0%, #2c3e50 100%);
    }
}

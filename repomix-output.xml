/* src/frontend/style.css */
/**
 * AUTO ACCESSORIES POS SYSTEM - MAIN STYLESHEET
 * Combined Base and App Styles for consistency
 */

:root {
    /* Color System */
    --primary-color: #0F172A;
    --primary-light: #1E293B;
    --secondary-color: #E5E7EB;
    --success-color: #16A34A;
    --danger-color: #DC2626;
    --warning-color: #FACC15;
    --info-color: #3B82F6;

    /* Typography */
    --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --font-size-base: clamp(13px, 1.2vw, 14px);
    --font-size-large: clamp(14px, 1.4vw, 16px);
    --font-size-xl: clamp(16px, 1.6vw, 18px);
    --font-size-xxl: clamp(20px, 2vw, 24px);

    /* Spacing */
    --spacing-xs: clamp(3px, 0.4vw, 4px);
    --spacing-sm: clamp(6px, 0.8vw, 8px);
    --spacing-md: clamp(12px, 1.2vw, 16px);
    --spacing-lg: clamp(18px, 1.8vw, 24px);
    --spacing-xl: clamp(24px, 2.4vw, 32px);

    /* Borders */
    --border-radius: 6px;
    --border-radius-sm: 4px;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1);

    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-normal: 250ms ease;
}

/* Reset & Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    background-color: #f5f5f5;
    color: #333;
    height: 100vh;
    width: 100vw;
}

#app {
    height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
}

/* Loading Screen */
.loading-screen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--primary-color);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.loading-content {
    text-align: center;
    color: white;
}

.loading-spinner {
    width: 60px;
    height: 60px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: white;
    animation: spin 1s ease-in-out infinite;
    margin: 0 auto 20px;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.loading-text {
    font-size: var(--font-size-xl);
    font-weight: 600;
    margin-bottom: 8px;
}

.loading-subtext {
    font-size: var(--font-size-base);
    opacity: 0.8;
}

/* Main Application Container */
.app-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #f8f9fa;
}

/* Header Styles */
.app-header {
    background-color: var(--primary-color);
    color: white;
    padding: 0;
    /* Removed padding to allow full-width internal wrapper */
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--shadow-md);
    z-index: 100;
    height: auto;
    /* Allow height to be determined by content if needed, or keep fixed */
    min-height: 70px;
    flex-shrink: 0;
}

.header-wrapper {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
}

.header-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.shop-info h1.shop-name {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
}

.business-status {
    font-size: 11px;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 6px;
    border-radius: 4px;
}

.header-center {
    text-align: center;
}

.header-time-display {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.header-date {
    font-size: var(--font-size-base);
    font-weight: 600;
    opacity: 0.9;
}

.header-time {
    font-size: var(--font-size-large);
    font-weight: 700;
}

.header-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.user-menu-btn,
.notification-btn,
.quick-actions-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    padding: 8px;
    border-radius: var(--border-radius);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all var(--transition-fast);
}

.user-menu-btn:hover,
.notification-btn:hover,
.quick-actions-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

.user-avatar {
    width: 32px;
    height: 32px;
    background: var(--info-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
}

.user-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-right: 4px;
}

.user-name {
    font-weight: 600;
    font-size: 13px;
    line-height: 1.2;
}

.user-role {
    font-size: 11px;
    opacity: 0.8;
}

/* Dropdowns */
.user-dropdown,
.notifications-dropdown,
.quick-actions-dropdown {
    position: absolute;
    top: 75px;
    right: 20px;
    background: white;
    color: #333;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg);
    width: 250px;
    border: 1px solid var(--secondary-color);
    overflow: hidden;
    z-index: 1000;
}

.dropdown-header {
    padding: 16px;
    background: #f8f9fa;
    border-bottom: 1px solid #eee;
}

.dropdown-item,
.action-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    text-decoration: none;
    color: #444;
    transition: background 0.2s;
}

.dropdown-item:hover,
.action-item:hover {
    background: #f0f4ff;
    color: var(--primary-color);
}

.dropdown-divider,
.action-divider {
    height: 1px;
    background: #eee;
    margin: 4px 0;
}

/* Main Content Layout */
.app-main {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
}

/* Sidebar Styles */
.app-sidebar {
    width: 260px;
    background: linear-gradient(180deg, #1E293B 0%, #0F172A 100%);
    color: #ecf0f1;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    z-index: 90;
    flex-shrink: 0;
    height: 100%;
}

.sidebar-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
}

.sidebar-header {
    padding: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-title {
    color: #fff;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    opacity: 0.7;
}

.sidebar-menu {
    flex: 1;
    overflow-y: auto;
    padding: 20px 12px;
}

.menu-section {
    margin-bottom: 24px;
}

.menu-label {
    padding: 0 12px 8px;
    font-size: 11px;
    text-transform: uppercase;
    color: #64748B;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.sidebar-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: none;
    background: transparent;
    color: #94A3B8;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: 4px;
}

.sidebar-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    transform: translateX(4px);
}

.sidebar-btn.active {
    background: var(--primary-color);
    /* Fallback */
    background: linear-gradient(90deg, #3B82F6 0%, #2563EB 100%);
    color: white;
    box-shadow: 0 4px 6px rgba(37, 99, 235, 0.2);
}

.btn-icon {
    font-size: 18px;
    width: 24px;
    text-align: center;
    display: flex;
    justify-content: center;
}

.sidebar-footer {
    padding: 16px;
    background: rgba(0, 0, 0, 0.2);

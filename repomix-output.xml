                        product_data['cost_price'],
                        product_data['cost_price'] * product_data['current_stock'],
                        None,
                        'product_creation',
                        'Initial stock',
                        'Product creation with initial stock',
                        user_id
                    ))
                
                # Get the created product directly from the same transaction
                cursor.execute('''
                    SELECT p.*, 
                           c.name as category_name,

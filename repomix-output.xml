                    )
                    ''')
                    
                    # 6. PRODUCT VARIANTS (Size, Color, etc.)
                    cursor.execute('''
                    CREATE TABLE IF NOT EXISTS product_variants (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        product_id INTEGER NOT NULL,

# ==================== PYDANTIC MODELS ====================

class LoginRequest(BaseModel):
    """Login request model"""
    username: str = Field(..., min_length=1, max_length=50)
    password: str = Field(..., min_length=1)
    device_info: Optional[str] = None
    
    @validator('username')
    def username_not_empty(cls, v):
